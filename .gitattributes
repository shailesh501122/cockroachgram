# Normalize line endings — critical for shell scripts and Docker files that
# will execute inside a Linux container even when checked out on Windows.

# Default: let git auto-detect, but normalize to LF in the repo.
* text=auto eol=lf

# Force LF on things that MUST be LF to run.
*.sh        text eol=lf
*.bash      text eol=lf
*.py        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
Dockerfile  text eol=lf
*.dockerfile text eol=lf
.env*       text eol=lf

# Force CRLF for files that Windows tools expect to be CRLF.
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Mark binary so git doesn't try to diff/normalize them.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary
*.pdf       binary
*.zip       binary
*.tar       binary
*.gz        binary
*.jar       binary
*.so        binary
*.dll       binary
*.exe       binary
