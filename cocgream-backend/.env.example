# ===== Django =====
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
# Comma-separated origins your Flutter app / web client will call from.
DJANGO_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ===== Database =====
POSTGRES_DB=cockroachgram
POSTGRES_USER=cockroach
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgres://cockroach:changeme@db:5432/cockroachgram

# ===== Redis =====
REDIS_URL=redis://redis:6379/0

# ===== Storage (S3-compatible) =====
# In dev these point at the local MinIO container.
# In prod, swap to real S3 / Cloudflare R2 / Backblaze B2 by changing these
# four values — no code changes needed.
USE_S3=true
AWS_ACCESS_KEY_ID=cockroach
AWS_SECRET_ACCESS_KEY=changeme-minio
AWS_STORAGE_BUCKET_NAME=cockroachgram-media
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_ADDRESSING_STYLE=path

# ===== JWT =====
JWT_ACCESS_LIFETIME_MINUTES=60
JWT_REFRESH_LIFETIME_DAYS=14

# ===== Admin bootstrap (used by `manage.py seed`) =====
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@cockroachgram.in
ADMIN_PASSWORD=cockroach-admin
